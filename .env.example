# ── Obligatorias ─────────────────────────────────────────────
# Supabase → Project Settings → API. La URL y la anon key se exponen al navegador.
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Service role: SOLO servidor (endpoints /api/* y backoffice). Nunca con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionales ───────────────────────────────────────────────
# Emails (separados por comas) con acceso al backoffice, además de los usuarios
# con app_metadata.role = 'admin' en Supabase Auth. Si se deja vacío, solo entran esos.
ADMIN_EMAILS=

# Clave de la API de Anthropic (console.anthropic.com → API keys). Activa el panel
# "Rellenar con IA" del alta de proyectos en el backoffice. Si se deja vacía, el panel
# muestra un aviso y todo lo demás funciona igual. Solo servidor.
ANTHROPIC_API_KEY=

# Solo si la API responde "This API key is not scoped to a workspace": ID del workspace
# (console.anthropic.com → Settings → Workspaces, "wrkspc_..."). Con una clave creada
# dentro de un workspace no hace falta.
ANTHROPIC_WORKSPACE_ID=
