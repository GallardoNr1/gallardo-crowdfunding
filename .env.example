# ── Obligatorias ─────────────────────────────────────────────
# Supabase → Project Settings → API. La URL y la anon key se exponen al navegador.
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Service role: SOLO servidor (endpoints /api/* y backoffice). Nunca con prefijo PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Opcionales ───────────────────────────────────────────────
# Emails (separados por comas) con acceso al backoffice, además de los usuarios
# con app_metadata.role = 'admin' en Supabase Auth. Si se deja vacío, solo entran esos.
ADMIN_EMAILS=
