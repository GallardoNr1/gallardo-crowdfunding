---
// Sección de progreso para campañas "por tiempo" (campaign_mode = 'open'):
// sin objetivo de dinero; la barra mide el tiempo (inicio → cierre) y se muestran
// lo recaudado, la aportación base y la cuenta atrás.
import type { CampaignTimeline } from '@/lib/campaign';

export interface Props {
  title?: string;
  raised: number;
  base: number;
  baseLabel?: string | null;
  total: number;
  currency?: string;
  daysLeft: number | null;
  endDateLabel: string;
  startDateLabel?: string;
  timeline?: CampaignTimeline | null;
  closed: boolean;
}

const {
  title = '🎯 Progreso',
  raised,
  base,
  baseLabel,
  total,
  currency = '€',
  daysLeft,
  endDateLabel,
  startDateLabel = '',
  timeline = null,
  closed,
} = Astro.props;

const timePercent = timeline ? Math.round(timeline.percent) : 0;

const countdown = closed
  ? 'Campaña cerrada'
  : daysLeft === null
    ? 'Sin fecha de cierre'
    : daysLeft === 0
      ? '¡Último día!'
      : daysLeft === 1
        ? 'Queda 1 día'
        : `Quedan ${daysLeft} días`;
---

<div class='progress-section open-campaign'>
  <h3 class='progress-title'>{title}</h3>

  <div class='totals'>
    <div class='total-item'>
      <span class='total-label'>Familia y amigos</span>
      <span class='total-value'>{raised.toFixed(2)} {currency}</span>
    </div>
    {
      base > 0 && (
        <>
          <span class='total-plus' aria-hidden='true'>+</span>
          <div class='total-item'>
            <span class='total-label'>{baseLabel || 'Aportación base'}</span>
            <span class='total-value'>{base.toFixed(2)} {currency}</span>
          </div>
        </>
      )
    }
    <span class='total-plus' aria-hidden='true'>=</span>
    <div class='total-item total-item--sum'>
      <span class='total-label'>Total conseguido</span>
      <span class='total-value'>{total.toFixed(2)} {currency}</span>
    </div>
  </div>

  {
    timeline && (
      <div class='time-progress'>
        <div class='time-labels'>
          <span>🚦 {startDateLabel || 'Inicio'}</span>
          <span>🏁 {endDateLabel || 'Cierre'}</span>
        </div>
        <div
          class='time-bar'
          role='progressbar'
          aria-label='Tiempo de campaña transcurrido'
          aria-valuemin='0'
          aria-valuemax='100'
          aria-valuenow={timePercent}
        >
          <div class='time-fill' style={`width: ${timePercent}%`}>
            <div class='time-shine' />
          </div>
        </div>
        <div class='time-caption'>
          {closed
            ? `Campaña de ${timeline.totalDays} días`
            : `Día ${timeline.dayNumber} de ${timeline.totalDays}`}
        </div>
      </div>
    )
  }

  <div class={`countdown ${closed ? 'countdown--closed' : ''}`}>
    <span class='countdown-main'>{closed ? '🏁' : '⏳'} {countdown}</span>
    {endDateLabel && !closed && <span class='countdown-sub'>cierra el {endDateLabel}</span>}
    {endDateLabel && closed && <span class='countdown-sub'>cerró el {endDateLabel}</span>}
  </div>

  {
    !closed && (
      <p class='open-hint'>
        No hay objetivo: todo lo que consigamos entre todos va íntegro al regalo. 💛
      </p>
    )
  }
</div>

<style>
  .open-campaign {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 30px 25px;
    box-shadow: var(--shadow-md);
    margin: 30px 0;
    text-align: center;
  }
  .progress-title {
    font-size: 1.6rem;
    margin: 0 0 22px;
    color: var(--color-text);
  }
  .totals {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 12px;
  }
  .total-item {
    flex: 1 1 160px;
    max-width: 240px;
    background: var(--color-surface-alt, #fafafa);
    border-radius: var(--radius-md);
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .total-item--sum {
    background: linear-gradient(135deg, var(--color-brand-orange), var(--color-brand-primary));
    color: #fff;
  }
  .total-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }
  .total-value {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .total-plus {
    align-self: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-muted, #888);
  }
  .time-progress {
    margin: 26px auto 0;
    max-width: 640px;
    text-align: left;
  }
  .time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }
  .time-bar {
    height: 22px;
    border-radius: 999px;
    background: linear-gradient(145deg, var(--color-section-progress-from), var(--color-section-progress-to));
    overflow: hidden;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.08);
  }
  .time-fill {
    height: 100%;
    min-width: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-brand-orange), var(--color-brand-primary));
    position: relative;
    transition: width 1.2s ease-out;
  }
  .time-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
    animation: timeShine 2.6s ease-in-out infinite;
  }
  @keyframes timeShine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .time-caption {
    margin-top: 8px;
    text-align: center;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .countdown {
    margin-top: 22px;
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #fff7ed;
    border: 2px solid #fdba74;
    color: #9a3412;
  }
  .countdown--closed {
    background: #f1f5f9;
    border-color: #cbd5e1;
    color: #334155;
  }
  .countdown-main {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .countdown-sub {
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .open-hint {
    margin: 18px 0 0;
    color: var(--color-text-muted, #666);
    font-size: 0.95rem;
  }
  @media (max-width: 600px) {
    .total-plus {
      flex-basis: 100%;
      font-size: 1.2rem;
    }
    .total-item {
      max-width: none;
    }
  }
</style>
