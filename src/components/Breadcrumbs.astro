---
// Migas de pan de las páginas públicas: "Inicio › Espacio › Proyecto".
// El último elemento es la página actual (sin enlace, aria-current).
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class='breadcrumbs' aria-label='Migas'>
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current='page'>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin: -22px 0 22px;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li + li::before {
    content: '›';
    margin-right: 6px;
    opacity: 0.6;
  }

  .breadcrumbs a {
    color: var(--color-brand-primary);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .breadcrumbs [aria-current] {
    font-weight: 600;
    color: var(--color-text-primary);
  }
</style>
