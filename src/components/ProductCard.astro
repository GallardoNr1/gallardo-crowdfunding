---
import CompletedBage from './UI/CompletedBage.astro';
import ShareButton from './ShareButton.astro';

export interface Props {
  title: string;
  description: string;
  /** Sin precio (campañas por tiempo) no se muestra el bloque. */
  price?: number;
  imageUrl: string;
  imageAlt: string;
  href?: string;
  completed?: boolean;
  icon?: string;
  currency?: string;
  /** Ancla de la sección de aportaciones; sin ella no se muestra el botón. */
  contributeHref?: string;
  contributeLabel?: string;
  /** Botón "Compartir" bajo la descripción. */
  share?: { url: string; title: string; text?: string };
}

const {
  title,
  description,
  price,
  imageUrl,
  imageAlt,
  href,
  completed,
  icon,
  currency = '€',
  contributeHref,
  contributeLabel = '💛 Quiero aportar',
  share,
} = Astro.props;
---

<div
  class='main-card'
  style={icon ? `--card-icon: "${icon}"` : undefined}
>
  {completed && <CompletedBage size='lg' />}

  {href ? (
    <a
      class='product-title'
      href={href}
      target='_blank'
      rel='noopener'
      title='Ver producto'
    >
      {imageUrl && (
        <img
          src={imageUrl}
          alt={imageAlt}
          class='lego-image'
        />
      )}
    </a>
  ) : (
    imageUrl && (
      <div class='product-title'>
        <img
          src={imageUrl}
          alt={imageAlt}
          class='lego-image'
        />
      </div>
    )
  )}

  <h2 class='product-title'>{title}</h2>
  <p class='product-description'>{description}</p>
  {share && (
    <ShareButton
      url={share.url}
      title={share.title}
      text={share.text}
      inline
    />
  )}

  {contributeHref && (
    <div class='contribute-cta-wrap'>
      <a
        class='contribute-cta'
        href={contributeHref}
      >
        <span class='cta-label'>{contributeLabel}</span>
        <span
          class='cta-arrow'
          aria-hidden='true'
        >
          👇
        </span>
      </a>
      <p class='contribute-cta-hint'>
        Elige un nivel o pon tu cantidad. ¡Es un momento!
      </p>
    </div>
  )}

  {price !== undefined && (
    <div class='price'>
      <span>💰</span>
      <span>
        {price.toFixed(2)} {currency}
      </span>
    </div>
  )}
</div>

<style>
  .main-card {
    background: linear-gradient(145deg, #ffffffcc, #f0f0f0);
    border-radius: var(--radius-2xl);
    padding: var(--space-10);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .main-card::before {
    content: var(--card-icon);
    position: absolute;
    top: -20px;
    right: -20px;
    font-size: 120px;
    opacity: 0.1;
    transform: rotate(15deg);
  }

  .lego-image {
    width: 100%;
    max-width: 560px;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    border-radius: var(--radius-lg);
    margin: 0 auto 30px;
    display: block;
    box-shadow: var(--shadow-lg);
    transition: var(--transition-normal);
  }

  .lego-image:hover {
    transform: scale(1.05);
  }

  .product-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    color: var(--color-brand-primary);
    margin-bottom: 15px;
    text-align: center;
  }

  .contribute-cta-wrap {
    text-align: center;
    margin: 10px 0 26px;
  }

  .contribute-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 42px;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      var(--color-brand-orange),
      var(--color-brand-primary)
    );
    color: #fff;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.2px;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
    animation: ctaPulse 2s ease-in-out infinite;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* brillo que barre el botón */
  .contribute-cta::after {
    content: '';
    position: absolute;
    top: 0;
    left: -70%;
    width: 45%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent,
      rgba(255, 255, 255, 0.5),
      transparent
    );
    transform: skewX(-20deg);
    animation: ctaShine 2.8s ease-in-out infinite;
    pointer-events: none;
  }

  .cta-arrow {
    display: inline-block;
    font-size: 1.3rem;
    animation: ctaArrow 1.1s ease-in-out infinite;
  }

  .contribute-cta:hover,
  .contribute-cta:focus-visible {
    transform: translateY(-4px) scale(1.07);
  }

  .contribute-cta-hint {
    margin: 12px 0 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  @keyframes ctaPulse {
    0%,
    100% {
      box-shadow:
        0 12px 30px rgba(0, 0, 0, 0.22),
        0 0 0 0 color-mix(in srgb, var(--color-brand-orange) 55%, transparent);
    }
    50% {
      box-shadow:
        0 12px 30px rgba(0, 0, 0, 0.22),
        0 0 0 18px color-mix(in srgb, var(--color-brand-orange) 0%, transparent);
    }
  }

  @keyframes ctaShine {
    0%,
    20% {
      left: -70%;
    }
    60%,
    100% {
      left: 130%;
    }
  }

  @keyframes ctaArrow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 600px) {
    .contribute-cta {
      width: 100%;
      justify-content: center;
      padding: 16px 24px;
      font-size: 1.1rem;
    }
  }

  .product-description {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: 20px;
    text-align: center;
  }

  .price {
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-green-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
  }

  @media (max-width: 768px) {
    .main-card {
      padding: 20px;
    }

    .product-title {
      font-size: 1.8rem;
    }

    .price {
      font-size: 1.5rem;
    }

    .completed-badge {
      font-size: 0.8rem;
      padding: 6px 12px;
    }
  }
</style>
