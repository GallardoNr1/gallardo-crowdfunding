---
import { ContributorsList as ReactContributorsList } from './react/ContributorsList';

const {
  contributors = [],
  currency = '€',
  showTotal = true,
  maxDisplay = 20,
  contributorsTitle = '',
  projectId,
} = Astro.props;
---

<ReactContributorsList
  client:load
  contributors={contributors}
  currency={currency}
  showTotal={showTotal}
  maxDisplay={maxDisplay}
  contributorsTitle={contributorsTitle}
  projectId={projectId}
/>
