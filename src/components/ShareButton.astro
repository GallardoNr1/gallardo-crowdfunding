---
// Botón "Compartir" (icono de nodos). Con Web Share API (móvil y algunos escritorios) abre el
// menú nativo; si no, copia el enlace y avisa. `iconOnly` para las tarjetas de la lista.
export interface Props {
  /** URL que se comparte (si es relativa, el navegador la hace absoluta). */
  url: string;
  title: string;
  text?: string;
  iconOnly?: boolean;
}

const { url, title, text = '', iconOnly = false } = Astro.props;
---

<div class={`share ${iconOnly ? 'share--icon' : ''}`}>
  <button
    type='button'
    class='share-btn'
    data-share-url={url}
    data-share-title={title}
    data-share-text={text}
    aria-label={`Compartir ${title}`}
    title='Compartir'
  >
    <svg
      class='share-icon'
      viewBox='0 0 24 24'
      aria-hidden='true'
    >
      <circle
        cx='18'
        cy='5'
        r='3'
      ></circle>
      <circle
        cx='6'
        cy='12'
        r='3'
      ></circle>
      <circle
        cx='18'
        cy='19'
        r='3'
      ></circle>
      <line
        x1='8.6'
        y1='13.5'
        x2='15.4'
        y2='17.5'
      ></line>
      <line
        x1='15.4'
        y1='6.5'
        x2='8.6'
        y2='10.5'
      ></line>
    </svg>
    {!iconOnly && <span>Compartir</span>}
  </button>
</div>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('.share-btn')
    .forEach((button) => {
      button.addEventListener('click', async () => {
        const { shareTitle = '', shareText = '' } = button.dataset;
        const shareUrl = new URL(
          button.dataset.shareUrl ?? '',
          location.href
        ).toString();
        const notify = (msg: string) =>
          (
            window as unknown as { showToast?: (m: string, k?: string) => void }
          ).showToast?.(msg, 'success') ?? alert(msg);

        if (navigator.share) {
          try {
            await navigator.share({
              title: shareTitle,
              text: shareText,
              url: shareUrl,
            });
            return;
          } catch {
            // Cancelado por la persona o no soportado con estos datos: pasamos a copiar.
          }
        }
        try {
          await navigator.clipboard.writeText(shareUrl);
          notify('Enlace copiado. ¡Pégalo donde quieras!');
        } catch {
          notify(`Copia este enlace: ${shareUrl}`);
        }
      });
    });
</script>

<style>
  .share {
    display: flex;
    justify-content: flex-end;
    margin: -8px 0 18px;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    border: none;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
    color: #fff;
    background: linear-gradient(
      135deg,
      var(--color-brand-orange),
      var(--color-brand-primary)
    );
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .share-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
  }

  .share-icon {
    display: block;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Solo icono (tarjetas de la lista): botón redondo con el icono centrado. */
  .share--icon {
    margin: 0;
  }

  .share--icon .share-btn {
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
  }

  @media (max-width: 600px) {
    .share:not(.share--icon) {
      justify-content: center;
    }
  }
</style>
