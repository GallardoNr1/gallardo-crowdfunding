---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { campaignTotals, daysLeft, isCampaignOpen } from '@/lib/campaign';
import { createAdminClient } from '@/lib/supabase-server';
import { projectUrl, tenantUrl } from '@/lib/tenants';

const supabase = createAdminClient();
const tenant = Astro.locals.tenant;
const welcome = Astro.url.searchParams.get('bienvenida') === '1';

// Solo los proyectos del espacio del usuario (o del que gestiona un superadmin).
const { data: projects, error } = tenant
  ? await supabase
      .from('project_config')
      .select('*, tenants(number, name)')
      .eq('tenant_id', tenant.id)
      .order('created_at', { ascending: false })
  : { data: [], error: null };

// Pendientes por proyecto (confirmar pagos / aprobar mensajes)
const [{ data: pendingContribs }, { data: pendingMessages }] =
  await Promise.all([
    supabase
      .from('contributions')
      .select('project_id')
      .eq('payment_status', 'pending'),
    supabase
      .from('support_messages')
      .select('project_id')
      .eq('is_approved', false),
  ]);
const countByProject = (rows: { project_id: string }[] | null) =>
  (rows ?? []).reduce<Record<string, number>>((acc, r) => {
    acc[r.project_id] = (acc[r.project_id] ?? 0) + 1;
    return acc;
  }, {});
const pendingContribCount = countByProject(pendingContribs);
const pendingMessageCount = countByProject(pendingMessages);

const statusLabel: Record<string, string> = {
  active: 'Activo',
  completed: 'Completado',
  paused: 'Pausado',
  cancelled: 'Cancelado',
};

const statusColor: Record<string, string> = {
  active: '#16a34a',
  completed: '#2563eb',
  paused: '#d97706',
  cancelled: '#dc2626',
};
---

<AdminLayout title='Proyectos'>
  <div class='toolbar'>
    <a
      href='/admin/projects/new'
      class='btn-primary'
    >
      ➕ Nuevo proyecto
    </a>
  </div>

  {!tenant && (
    <div class='alert-error'>
      Tu cuenta no tiene espacio asignado. Contacta con el administrador de la
      web.
    </div>
  )}

  {welcome && tenant && (
    <div class='welcome-card'>
      <h2>🎉 ¡Bienvenido a tu espacio, {tenant.name}!</h2>
      <p>
        Crea tu primer proyecto: cuéntale a la IA de qué va o rellena el
        formulario a mano. Tu portada pública es{' '}
        <a href={tenantUrl(tenant.number)}>{tenantUrl(tenant.number)}</a>; los
        proyectos privados solo se ven con su enlace.
      </p>
      <a
        href='/admin/projects/new'
        class='btn-primary'
      >
        ➕ Crear mi primer proyecto
      </a>
    </div>
  )}

  {error && (
    <div class='alert-error'>Error cargando proyectos: {error.message}</div>
  )}

  {!error && projects?.length === 0 && (
    <div class='empty-state'>
      <p>No hay proyectos todavía.</p>
      <a
        href='/admin/projects/new'
        class='btn-primary'
      >
        Crear el primero
      </a>
    </div>
  )}

  {!error && projects && projects.length > 0 && (
    <div class='projects-grid'>
      {projects.map((p) => {
        const pct = p.target_amount
          ? Math.min(
              100,
              Math.round((p.current_amount / p.target_amount) * 100)
            )
          : 0;
        return (
          <div class='project-card'>
            <div class='card-header'>
              <div>
                <h2 class='project-name'>{p.project_name}</h2>
                <code class='project-slug'>
                  {projectUrl(p.tenants?.number ?? 0, p.slug)}
                </code>
                <span class='vis-badge'>
                  {p.visibility === 'public' ? '🌍 Público' : '🔒 Privado'}
                </span>
              </div>
              <span
                class='status-badge'
                style={`color: ${statusColor[p.project_status] ?? '#666'}; background: ${statusColor[p.project_status] ?? '#666'}18`}
              >
                {statusLabel[p.project_status] ?? p.project_status}
              </span>
            </div>

            {p.campaign_mode === 'open' ? (
              <div class='progress-area'>
                <div class='progress-text'>
                  <span>
                    Conseguido: {campaignTotals(p).total.toFixed(2)}{' '}
                    {p.currency}
                  </span>
                  <span>
                    {isCampaignOpen(p)
                      ? `⏳ ${daysLeft(p.end_date) ?? '∞'} días`
                      : '🏁 Cerrada'}
                  </span>
                </div>
              </div>
            ) : (
              <div class='progress-area'>
                <div class='progress-bar'>
                  <div
                    class='progress-fill'
                    style={`width: ${pct}%`}
                  />
                </div>
                <div class='progress-text'>
                  <span>
                    {p.current_amount ?? 0} {p.currency}
                  </span>
                  <span>
                    {pct}% de {p.target_amount} {p.currency}
                  </span>
                </div>
              </div>
            )}

            <div class='card-actions'>
              <a
                href={projectUrl(p.tenants?.number ?? 0, p.slug)}
                target='_blank'
                class='btn-ghost'
              >
                👁 Ver
              </a>
              <a
                href={`/admin/projects/${p.id}/edit`}
                class='btn-secondary'
              >
                ✏️ Editar
              </a>
              <a
                href={`/admin/projects/${p.id}/contributions`}
                class={`btn-ghost ${pendingContribCount[p.id] ? 'has-pending' : ''}`}
              >
                💳 Contribuciones
                {pendingContribCount[p.id]
                  ? ` (${pendingContribCount[p.id]})`
                  : ''}
              </a>
              <a
                href={`/admin/projects/${p.id}/messages`}
                class={`btn-ghost ${pendingMessageCount[p.id] ? 'has-pending' : ''}`}
              >
                💬 Mensajes
                {pendingMessageCount[p.id]
                  ? ` (${pendingMessageCount[p.id]})`
                  : ''}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  )}
</AdminLayout>

<style>
  .toolbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 24px;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .project-card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-admin-border);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 12px;
  }

  .project-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-admin-text);
    margin-bottom: 4px;
  }

  .project-slug {
    font-size: 0.8rem;
    color: var(--color-admin-text-muted);
    background: var(--color-admin-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .vis-badge {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.75rem;
    color: var(--color-admin-text-muted);
  }

  .status-badge {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .progress-area {
    margin-bottom: 16px;
  }

  .progress-bar {
    height: 8px;
    background: var(--color-admin-border);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-admin-primary),
      var(--color-brand-purple)
    );
    border-radius: 4px;
    transition: width 0.3s;
  }

  .progress-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--color-admin-text-muted);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-end;
  }

  .btn-primary {
    background: var(--color-admin-primary);
    color: #fff;
    padding: 9px 18px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: var(--transition-fast);
  }

  .btn-primary:hover {
    background: var(--color-admin-primary-dk);
  }

  .btn-secondary {
    background: var(--color-admin-bg);
    color: var(--color-text-secondary);
    padding: 7px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--color-admin-border);
  }

  .btn-ghost {
    color: var(--color-admin-text-muted);
    padding: 7px 12px;
    border: 1px solid var(--color-admin-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-fast);
  }

  .btn-ghost:hover {
    background: var(--color-admin-bg);
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-admin-text-muted);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: var(--color-error);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    margin-bottom: 20px;
  }
  .has-pending {
    border-color: #f59e0b;
    color: #92400e;
    background: #fffbeb;
  }

  .welcome-card {
    background: linear-gradient(135deg, #eef2ff, #f5f3ff);
    border: 1px solid #c7d2fe;
    border-radius: var(--radius-md);
    padding: 22px 24px;
    margin-bottom: 24px;
  }

  .welcome-card h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: #3730a3;
  }

  .welcome-card p {
    margin: 0 0 14px;
    color: #4338ca;
    line-height: 1.5;
  }

  .welcome-card a:not(.btn-primary) {
    color: #3730a3;
    font-weight: 600;
  }
</style>
