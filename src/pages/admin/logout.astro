---
export const prerender = false;

import { createAdminClient } from '@/lib/supabase-server';
import { ACCESS_COOKIE, clearSessionCookies } from '@/lib/session-cookies';

if (Astro.request.method === 'POST') {
  const accessToken = Astro.cookies.get(ACCESS_COOKIE)?.value;
  if (accessToken) {
    // Revoca la sesión en Supabase (no solo la cookie) para que el refresh token deje de valer.
    const { error } = await createAdminClient().auth.admin.signOut(accessToken, 'local');
    if (error) console.warn('[auth] signOut falló:', error.message);
  }
  clearSessionCookies(Astro.cookies);
  return Astro.redirect('/admin/login');
}

return Astro.redirect('/admin');
---
