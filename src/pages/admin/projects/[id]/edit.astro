<script>
  import { initCampaignForm } from '@/lib/client/campaign-form';
  import { initSaveBar } from '@/lib/client/save-bar';
  import { initTabs } from '@/lib/client/tabs';
  import { initThemePicker } from '@/lib/client/theme-picker';

  const projectForm =
    document.querySelector<HTMLFormElement>('form.project-form');
  initCampaignForm(projectForm);
  const saveBar = initSaveBar(projectForm, document.getElementById('saveBar'));
  initTabs(document.getElementById('projectTabs'), {
    isDirty: saveBar.isDirty,
  });
  initThemePicker(document.getElementById('themePicker'));
</script>

<script>
  // Copiar el enlace público al portapapeles (sin librerías).
  const copyButton = document.getElementById('copyPublicLink');
  copyButton?.addEventListener('click', async () => {
    const url = copyButton.dataset.copy ?? '';
    const original = copyButton.textContent;
    try {
      await navigator.clipboard.writeText(url);
      copyButton.textContent = '✅ Copiado';
    } catch {
      copyButton.textContent = 'No se pudo copiar';
    }
    setTimeout(() => (copyButton.textContent = original), 2000);
  });
</script>

<script>
  import { initAiDraftPanel } from '@/lib/client/ai-draft';

  const form = document.querySelector<HTMLFormElement>('form.project-form');
  if (form)
    initAiDraftPanel(document.getElementById('aiDraftPanel'), {
      form,
      levels: null,
    });
</script>
