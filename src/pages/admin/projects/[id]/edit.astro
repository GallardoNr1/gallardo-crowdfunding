---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { parseProjectForm } from '@/lib/project-form';
import { uploadProjectImage } from '@/lib/project-image-server';
import { createAdminClient } from '@/lib/supabase-server';
import { DEFAULT_THEME_ID, THEMES, THEME_IDS, isThemeId } from '@/lib/themes';

const { id } = Astro.params;
const supabase = createAdminClient();

let error = '';
let successMsg = '';
let fieldErrors: Record<string, string> = {};

// Se carga antes del POST para conservar lo que el formulario no edita (stats del CTA)
// y para comprobar el slug.
const { data: current } = await supabase
  .from('project_config')
  .select('*')
  .eq('id', id)
  .maybeSingle();

if (!current) {
  return Astro.redirect('/admin');
}

// ── Manejar acciones POST ────────────────────────────────────────────────────
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action') as string;

  // Actualizar datos del proyecto
  if (action === 'update_project') {
    const parsed = parseProjectForm(form);

    if (!parsed.ok) {
      fieldErrors = parsed.fields;
      error = 'Revisa los campos marcados.';
    } else {
      const { data: clash } = await supabase
        .from('project_config')
        .select('id')
        .eq('slug', parsed.data.slug)
        .neq('id', id)
        .maybeSingle();

      if (clash) {
        error = `Ya existe otro proyecto con el slug "${parsed.data.slug}".`;
      } else {
        const existingStats =
          (current.page_content as { cta?: { stats?: { number: string; label: string }[] } } | null)
            ?.cta?.stats ?? [];
        const { error: dbErr } = await supabase
          .from('project_config')
          .update({
            ...parsed.data,
            page_content: {
              ...parsed.data.page_content,
              cta: { ...parsed.data.page_content.cta, stats: existingStats },
            },
            updated_at: new Date().toISOString(),
          })
          .eq('id', id);

        if (dbErr) {
          error = dbErr.message;
        } else {
          successMsg = '✅ Proyecto actualizado correctamente.';
          const upload = await uploadProjectImage(supabase, id!, form.get('project_image'));
          if (!upload.ok) error = `La imagen no se ha subido: ${upload.error}`;
          else if (upload.url) successMsg = '✅ Proyecto e imagen actualizados.';
        }
      }
    }
  }

  // Añadir nivel de contribución
  if (action === 'add_level') {
    const name = String(form.get('level_name') ?? '').trim();
    const amount = parseFloat(String(form.get('level_amount') ?? ''));
    if (!name || !Number.isFinite(amount) || amount <= 0) {
      error = 'El nivel necesita un nombre y un importe mayor que 0.';
    } else {
      const { error: dbErr } = await supabase.from('contribution_levels').insert([
        {
          project_id: id,
          name,
          amount,
          emoji: (form.get('level_emoji') as string) || '⭐',
          description: (form.get('level_description') as string) || '',
          color: (form.get('level_color') as string) || '#6366f1',
          rewards: [],
          is_active: true,
          sort_order: parseInt(form.get('level_sort_order') as string) || 0,
        },
      ]);

      if (dbErr) error = dbErr.message;
      else successMsg = '✅ Nivel añadido.';
    }
  }

  // Eliminar nivel de contribución
  if (action === 'delete_level') {
    const levelId = form.get('level_id') as string;
    const { error: dbErr } = await supabase
      .from('contribution_levels')
      .delete()
      .eq('id', levelId)
      .eq('project_id', id);

    if (dbErr) error = dbErr.message;
    else successMsg = '✅ Nivel eliminado.';
  }

  // Añadir emoji option
  if (action === 'add_emoji') {
    const emojiValue = (form.get('emoji_value') as string).trim();
    const emojiLabel = (form.get('emoji_label') as string).trim();
    if (emojiValue && emojiLabel) {
      const currentOptions = (current.emoji_options ?? []) as { value: string; label: string }[];
      const { error: dbErr } = await supabase
        .from('project_config')
        .update({ emoji_options: [...currentOptions, { value: emojiValue, label: emojiLabel }] })
        .eq('id', id);
      if (dbErr) error = dbErr.message;
      else successMsg = '✅ Emoji añadido.';
    }
  }

  // Eliminar emoji option
  if (action === 'delete_emoji') {
    const idx = parseInt(form.get('emoji_index') as string);
    const currentOptions = (current.emoji_options ?? []) as { value: string; label: string }[];
    const updated = currentOptions.filter((_, i) => i !== idx);
    const { error: dbErr } = await supabase
      .from('project_config')
      .update({ emoji_options: updated })
      .eq('id', id);
    if (dbErr) error = dbErr.message;
    else successMsg = '✅ Emoji eliminado.';
  }
}

// ── Cargar datos actuales (tras el POST) ─────────────────────────────────────
const [{ data: project, error: projectErr }, { data: levels }] = await Promise.all([
  supabase.from('project_config').select('*').eq('id', id).single(),
  supabase.from('contribution_levels').select('*').eq('project_id', id).order('sort_order'),
]);

if (projectErr || !project) {
  return Astro.redirect('/admin');
}

// Desempaquetar page_content con defaults
const pc = (project.page_content ?? {}) as Record<string, any>;
const mm = pc.mainMessage ?? {};
const cta = pc.cta ?? {};

const emojiOptions = (project.emoji_options ?? []) as { value: string; label: string }[];

const createdParam = Astro.url.searchParams.get('created');
if (createdParam) successMsg = '✅ Proyecto creado. Ahora añade los niveles de contribución.';
const imageErrorParam = Astro.url.searchParams.get('image_error');
if (imageErrorParam) error = `La imagen no se ha subido: ${imageErrorParam}`;
const currentTheme = isThemeId(pc.theme) ? pc.theme : DEFAULT_THEME_ID;
---

<AdminLayout title={`Editar: ${project.project_name}`}>
  {successMsg && <div class='alert-success'>{successMsg}</div>}
  {error && <div class='alert-error'>⚠️ {error}</div>}
  {
    Object.keys(fieldErrors).length > 0 && (
      <ul class='alert-error field-errors'>
        {Object.entries(fieldErrors).map(([field, message]) => (
          <li>
            <code>{field}</code>: {message}
          </li>
        ))}
      </ul>
    )
  }

  <nav class='subnav'>
    <a href={`/admin/projects/${id}/contributions`} class='subnav-link'>💳 Contribuciones</a>
    <a href={`/admin/projects/${id}/messages`} class='subnav-link'>💬 Mensajes de apoyo</a>
    <a href={`/projects/${project.slug}`} target='_blank' class='subnav-link'>👁 Ver página</a>
  </nav>

  <!-- ── Formulario del proyecto ─────────────────────────────────────────── -->
  <form method='POST' class='project-form' enctype='multipart/form-data'>
    <input type='hidden' name='_action' value='update_project' />

    <section class='form-section'>
      <h2 class='section-title'>1. ¿Cómo termina la campaña?</h2>
      <div class='mode-options'>
        <label class='mode-option'>
          <input type='radio' name='campaign_mode' value='target' checked={project.campaign_mode !== 'open'} />
          <span class='mode-option__body'>
            <strong>🎯 Al alcanzar un objetivo de dinero</strong>
            <small>Hay un producto concreto con precio. Barra de progreso y porcentaje. La fecha de cierre es opcional.</small>
          </span>
        </label>
        <label class='mode-option'>
          <input type='radio' name='campaign_mode' value='open' checked={project.campaign_mode === 'open'} />
          <span class='mode-option__body'>
            <strong>⏳ En una fecha de cierre (recaudar lo máximo posible)</strong>
            <small>Sin objetivo ni producto fijo: lo que se compre depende de lo recaudado. Se muestra lo conseguido, la aportación base y una cuenta atrás.</small>
          </span>
        </label>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>2. Información básica</h2>
      <div class='form-grid'>
        <div class='field full'>
          <label for='project_name'>Nombre del proyecto *</label>
          <input type='text' name='project_name' id='project_name' required value={project.project_name} />
        </div>

        <div class='field'>
          <label for='slug'>Slug (URL) *</label>
          <div class='input-prefix'>
            <span class='prefix'>/projects/</span>
            <input type='text' name='slug' id='slug' required value={project.slug}
              pattern='[a-z0-9\-]+' title='Solo letras minúsculas, números y guiones' />
          </div>
          <small>Solo minúsculas, números y guiones.</small>
        </div>

        <div class='field'>
          <label for='project_status'>Estado</label>
          <select name='project_status' id='project_status'>
            {['active', 'paused', 'completed', 'cancelled'].map((s) => (
              <option value={s} selected={project.project_status === s}>
                {s === 'active' ? 'Activo'
                  : s === 'paused' ? 'Pausado'
                  : s === 'completed' ? 'Completado'
                  : 'Cancelado'}
              </option>
            ))}
          </select>
        </div>

        <div class='field full'>
          <label for='project_description'>Descripción</label>
          <textarea name='project_description' id='project_description' rows='3'>{project.project_description ?? ''}</textarea>
        </div>

        <div class='field' data-mode='target'>
          <label for='target_amount'>Meta (importe) *</label>
          <input type='number' name='target_amount' id='target_amount' min='1' step='0.01'
            value={project.target_amount || ''} data-required-in='target' />
        </div>

        <div class='field'>
          <label for='currency'>Moneda</label>
          <input type='text' name='currency' id='currency' value={project.currency ?? 'EUR'} maxlength='5' />
        </div>

        <div class='field full'>
          <label for='project_image'>Imagen (subir desde el dispositivo)</label>
          <input type='file' name='project_image' id='project_image' accept='image/jpeg,image/png,image/webp,image/gif' />
          <small>JPG, PNG, WEBP o GIF, máximo 5 MB. Si subes un archivo, sustituye a la imagen actual.</small>
          {project.project_image_url && (
            <img src={project.project_image_url} alt='Imagen actual del proyecto' class='image-preview' />
          )}
        </div>

        <div class='field full'>
          <label for='project_image_url'>… o URL de la imagen</label>
          <input type='url' name='project_image_url' id='project_image_url' value={project.project_image_url ?? ''} />
          <small data-mode='open'>En campañas por tiempo es solo ilustrativa (no enlaza a ningún producto).</small>
        </div>

        <div class='field'>
          <label for='start_date'>Fecha de inicio</label>
          <input type='date' name='start_date' id='start_date'
            value={project.start_date ? project.start_date.split('T')[0] : ''} />
        </div>

        <div class='field'>
          <label for='end_date'>Fecha de cierre</label>
          <input type='date' name='end_date' id='end_date'
            value={project.end_date ? project.end_date.split('T')[0] : ''} data-required-in='open' />
          <small data-mode='open'>Obligatoria: la campaña se cierra sola al terminar ese día.</small>
          <small data-mode='target'>Opcional: si se indica, la campaña se cierra sola al terminar ese día.</small>
        </div>

        <div class='field full'>
          <label for='redirect_url'>URL de redirección al finalizar</label>
          <input type='text' name='redirect_url' id='redirect_url' value={project.redirect_url ?? '/'} />
        </div>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Aspecto</h2>
      <p class='section-hint'>Colores y emojis decorativos de la página del proyecto (no cambia los emojis que escribes tú).</p>
      <div class='theme-options'>
        {
          THEME_IDS.map((id) => {
            const t = THEMES[id];
            return (
              <label class='theme-option'>
                <input type='radio' name='theme' value={id} checked={currentTheme === id} />
                <span class='theme-option__body'>
                  <span class='theme-swatch' aria-hidden='true'>
                    {t.swatch.map((c) => <i style={`background:${c}`} />)}
                  </span>
                  <strong>{t.name}</strong>
                  <small>{t.description}</small>
                  <span class='theme-emojis' aria-hidden='true'>
                    {t.emojis.levels} {t.emojis.message} {t.emojis.support} {t.emojis.family} {t.emojis.modal} {t.emojis.spark}
                  </span>
                </span>
              </label>
            );
          })
        }
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Aportaciones</h2>
      <div class='form-grid'>
        <div class='field' data-mode='open'>
          <label for='base_amount'>Aportación base (la pone la familia)</label>
          <input type='number' name='base_amount' id='base_amount' min='0' step='0.01' value={project.base_amount ?? 0} />
        </div>
        <div class='field' data-mode='open'>
          <label for='base_label'>Etiqueta de la aportación base</label>
          <input type='text' name='base_label' id='base_label' placeholder='Papá y mamá' maxlength='60' value={project.base_label ?? ''} />
        </div>
        <div class='field'>
          <label for='allow_custom_amount'>Permitir "otra cantidad"</label>
          <input type='checkbox' name='allow_custom_amount' id='allow_custom_amount' checked={!!project.allow_custom_amount} />
        </div>
        <div class='field'>
          <label for='min_custom_amount'>Mínimo para "otra cantidad"</label>
          <input type='number' name='min_custom_amount' id='min_custom_amount' min='1' step='0.01' value={project.min_custom_amount ?? 5} />
        </div>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Pago — Bizum</h2>
      <div class='form-grid'>
        <div class='field'>
          <label for='bizum_phone'>Número de Bizum</label>
          <input type='text' name='bizum_phone' id='bizum_phone' value={project.bizum_phone ?? ''} />
        </div>
        <div class='field'>
          <label for='bizum_concept'>Concepto Bizum</label>
          <input type='text' name='bizum_concept' id='bizum_concept' value={project.bizum_concept ?? ''} />
        </div>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Contenido de la página</h2>
      <div class='form-grid'>
        <div class='field full'>
          <label for='pageTitle'>Título de la página</label>
          <input type='text' name='pageTitle' id='pageTitle' value={pc.pageTitle ?? ''} />
        </div>
        <div class='field full'>
          <label for='pageSubtitle'>Subtítulo</label>
          <input type='text' name='pageSubtitle' id='pageSubtitle' value={pc.pageSubtitle ?? ''} />
        </div>
        <div class='field full' data-mode='target'>
          <label for='productUrl'>URL del producto</label>
          <input type='url' name='productUrl' id='productUrl' value={pc.productUrl ?? ''} />
        </div>

        <div class='field'>
          <label for='progressTitle'>Título sección progreso</label>
          <input type='text' name='progressTitle' id='progressTitle' value={pc.progressTitle ?? '🎯 Progreso'} />
        </div>
        <div class='field'>
          <label for='contributorsTitle'>Título sección contribuidores</label>
          <input type='text' name='contributorsTitle' id='contributorsTitle' value={pc.contributorsTitle ?? '✨ Contribuidores'} />
        </div>
        <div class='field full'>
          <label for='photoSectionTitle'>Título sección fotos</label>
          <input type='text' name='photoSectionTitle' id='photoSectionTitle' value={pc.photoSectionTitle ?? '📸 Fotos'} />
        </div>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Mensaje principal de la familia</h2>
      <div class='form-grid'>
        <div class='field full'>
          <label for='mainMessage_message'>Mensaje</label>
          <textarea name='mainMessage_message' id='mainMessage_message' rows='5'>{mm.message ?? ''}</textarea>
        </div>
        <div class='field'>
          <label for='mainMessage_signature'>Firma</label>
          <input type='text' name='mainMessage_signature' id='mainMessage_signature' value={mm.signature ?? ''} />
        </div>
        <div class='field'>
          <label for='mainMessage_familyName'>Nombre de familia</label>
          <input type='text' name='mainMessage_familyName' id='mainMessage_familyName' value={mm.familyName ?? ''} />
        </div>
        <div class='field'>
          <label for='mainMessage_date'>Fecha del mensaje</label>
          <input type='text' name='mainMessage_date' id='mainMessage_date' value={mm.date ?? ''} />
        </div>
      </div>
    </section>

    <section class='form-section'>
      <h2 class='section-title'>Call to Action (CTA)</h2>
      <div class='form-grid'>
        <div class='field'>
          <label for='cta_icon'>Icono (emoji)</label>
          <input type='text' name='cta_icon' id='cta_icon' value={cta.icon ?? '🎁'} maxlength='4' />
        </div>
        <div class='field'>
          <label for='cta_title'>Título del CTA</label>
          <input type='text' name='cta_title' id='cta_title' value={cta.title ?? ''} />
        </div>
        <div class='field full'>
          <label for='cta_text'>Texto del CTA</label>
          <textarea name='cta_text' id='cta_text' rows='3'>{cta.text ?? ''}</textarea>
        </div>
      </div>
    </section>

    <div class='form-actions'>
      <a href='/admin' class='btn-ghost'>← Volver</a>
      <button type='submit' class='btn-primary'>Guardar cambios</button>
    </div>
  </form>

  <!-- ── Niveles de contribución ─────────────────────────────────────────── -->
  <section class='form-section levels-section'>
    <h2 class='section-title'>Niveles de contribución</h2>

    {levels && levels.length > 0 ? (
      <div class='levels-list'>
        {levels.map((level) => (
          <div class='level-row'>
            <span class='level-emoji'>{level.emoji}</span>
            <div class='level-info'>
              <strong>{level.name}</strong>
              <span class='level-amount'>{level.amount} {project.currency}</span>
              {level.description && <span class='level-desc'>{level.description}</span>}
            </div>
            <div class='level-meta'>
              <span class='color-dot' style={`background: ${level.color}`} />
              <span class='sort-badge'>#{level.sort_order}</span>
            </div>
            <form method='POST' class='delete-form'>
              <input type='hidden' name='_action' value='delete_level' />
              <input type='hidden' name='level_id' value={level.id} />
              <button type='submit' class='btn-delete'
                onclick="return confirm('¿Eliminar este nivel?')">
                🗑
              </button>
            </form>
          </div>
        ))}
      </div>
    ) : (
      <p class='no-levels'>No hay niveles todavía. Añade el primero.</p>
    )}

    <details class='add-level-details'>
      <summary class='add-level-summary'>➕ Añadir nivel</summary>
      <form method='POST' class='add-level-form'>
        <input type='hidden' name='_action' value='add_level' />
        <div class='form-grid'>
          <div class='field'>
            <label for='level_name'>Nombre *</label>
            <input type='text' name='level_name' id='level_name' required placeholder='Paladín' />
          </div>
          <div class='field'>
            <label for='level_amount'>Importe (€) *</label>
            <input type='number' name='level_amount' id='level_amount' required min='1' step='0.01' placeholder='25' />
          </div>
          <div class='field'>
            <label for='level_emoji'>Emoji</label>
            <input type='text' name='level_emoji' id='level_emoji' value='⭐' maxlength='4' />
          </div>
          <div class='field'>
            <label for='level_color'>Color</label>
            <input type='color' name='level_color' id='level_color' value='#6366f1' />
          </div>
          <div class='field'>
            <label for='level_sort_order'>Orden</label>
            <input type='number' name='level_sort_order' id='level_sort_order' value={levels ? levels.length : 0} min='0' />
          </div>
          <div class='field full'>
            <label for='level_description'>Descripción (opcional)</label>
            <input type='text' name='level_description' id='level_description' placeholder='Para los más generosos...' />
          </div>
        </div>
        <button type='submit' class='btn-primary' style='margin-top: 12px;'>
          Añadir nivel
        </button>
      </form>
    </details>
  </section>

  <!-- ── Emoji options ──────────────────────────────────────────────────── -->
  <section class='form-section levels-section'>
    <h2 class='section-title'>Emojis del modal de contribución</h2>
    <p class='section-hint'>
      Los contribuidores eligen uno al registrar su aportación.
      {emojiOptions.length === 0 && ' Sin emojis propios se usará el fallback del sistema.'}
    </p>

    {emojiOptions.length > 0 ? (
      <div class='emoji-list'>
        {emojiOptions.map((opt, i) => (
          <div class='emoji-row'>
            <span class='emoji-icon'>{opt.value}</span>
            <div class='emoji-info'>
              <strong>{opt.label}</strong>
            </div>
            <form method='POST' class='delete-form'>
              <input type='hidden' name='_action' value='delete_emoji' />
              <input type='hidden' name='emoji_index' value={i} />
              <button type='submit' class='btn-delete'
                onclick="return confirm('¿Eliminar este emoji?')">
                🗑
              </button>
            </form>
          </div>
        ))}
      </div>
    ) : (
      <p class='no-levels'>Sin emojis personalizados todavía.</p>
    )}

    <details class='add-level-details'>
      <summary class='add-level-summary'>➕ Añadir emoji</summary>
      <form method='POST' class='add-level-form'>
        <input type='hidden' name='_action' value='add_emoji' />
        <div class='form-grid'>
          <div class='field'>
            <label for='emoji_value'>Emoji *</label>
            <input type='text' name='emoji_value' id='emoji_value' required maxlength='4' placeholder='🙂' />
            <small>Un solo emoji</small>
          </div>
          <div class='field'>
            <label for='emoji_label'>Etiqueta *</label>
            <input type='text' name='emoji_label' id='emoji_label' required placeholder='Amigo de la familia' />
            <small>Texto que verá el contribuidor</small>
          </div>
        </div>
        <button type='submit' class='btn-primary' style='margin-top: 12px;'>
          Añadir emoji
        </button>
      </form>
    </details>
  </section>

  <!-- ── Enlace a la página pública ─────────────────────────────────────── -->
  <div class='public-link'>
    <span>Ver página pública:</span>
    <a href={`/projects/${project.slug}`} target='_blank' class='public-url'>
      /projects/{project.slug} ↗
    </a>
  </div>
</AdminLayout>

<style>
  .alert-success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: var(--color-success);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    margin-bottom: 24px;
    font-weight: var(--font-weight-medium);
  }

  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: var(--color-error);
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    margin-bottom: 24px;
  }

  .project-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 24px;
    width: 100%;
  }

