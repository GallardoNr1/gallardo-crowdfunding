---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { listContributions, setContributionStatus } from '@/lib/contributions-server';
import { currencySymbol } from '@/lib/format';
import { ContributionStatus } from '@/lib/schemas';
import { createAdminClient } from '@/lib/supabase-server';
import { requireProjectInTenant } from '@/lib/tenants-server';

const { id } = Astro.params;
const admin = createAdminClient();
// Solo proyectos del espacio del usuario (o del que gestiona un superadmin): 404 si no es suyo.
const scopedProject = Astro.locals.tenant
  ? await requireProjectInTenant(admin, id ?? '', Astro.locals.tenant.id)
  : null;
if (!scopedProject) {
  return new Response(null, { status: 404 });
}

let error = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const contributionId = String(form.get('contribution_id') ?? '');
  const status = ContributionStatus.safeParse(form.get('status'));

  if (form.get('_action') === 'set_status' && contributionId && status.success) {
    const result = await setContributionStatus(admin, contributionId, status.data);
    if (result.ok) {
      successMsg =
        status.data === 'completed'
          ? '✅ Pago confirmado. El importe del proyecto se ha actualizado.'
          : `✅ Contribución marcada como "${status.data}".`;
    } else {
      error = result.error;
    }
  } else {
    error = 'Acción no válida.';
  }
}

const { data: project } = await admin
  .from('project_config')
  .select('id, project_name, slug, currency, current_amount, target_amount')
  .eq('id', id)
  .maybeSingle();

if (!project) {
  return Astro.redirect('/admin');
}

const rows = await listContributions(admin, project.id);
const currency = currencySymbol(project.currency);
const pendingCount = rows.filter((r) => r.payment_status === 'pending').length;

const statusLabel: Record<string, string> = {
  pending: 'Pendiente',
  processing: 'En proceso',
  completed: 'Confirmada',
  failed: 'Anulada',
  refunded: 'Devuelta',
};

const methodLabel: Record<string, string> = {
  bizum: 'Bizum',
  cash: 'Efectivo',
  bank_transfer: 'Transferencia',
};

const fmtDate = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' })
    : '—';
---

<AdminLayout title={`Contribuciones: ${project.project_name}`}>
  <nav class='subnav'>
    <a href={`/admin/projects/${project.id}/edit`} class='btn-ghost'>✏️ Editar proyecto</a>
    <a href={`/admin/projects/${project.id}/messages`} class='btn-ghost'>💬 Mensajes de apoyo</a>
    <a href={`/projects/${project.slug}`} target='_blank' class='btn-ghost'>👁 Ver página</a>
  </nav>

  {successMsg && <div class='alert-success'>{successMsg}</div>}
  {error && <div class='alert-error'>⚠️ {error}</div>}

  <section class='summary'>
    <div class='summary-item'>
      <span class='summary-number'>
        {Number(project.current_amount ?? 0).toFixed(2)} {currency}
      </span>
      <span class='summary-label'>
        confirmado de {Number(project.target_amount ?? 0).toFixed(2)} {currency}
      </span>
    </div>
    <div class='summary-item'>
      <span class='summary-number'>{pendingCount}</span>
      <span class='summary-label'>pendientes de confirmar</span>
    </div>
    <div class='summary-item'>
      <span class='summary-number'>{rows.length}</span>
      <span class='summary-label'>contribuciones en total</span>
    </div>
  </section>

  {
    rows.length === 0 ? (
      <p class='empty-state'>Todavía no hay contribuciones registradas.</p>
    ) : (
      <div class='table-wrap'>
        <table class='data-table'>
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Contribuidor</th>
              <th>Nivel</th>
              <th>Importe</th>
              <th>Método</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((c) => (
              <tr class={`row-${c.payment_status}`}>
                <td>{fmtDate(c.created_at)}</td>
                <td>
                  <strong>
                    {c.contributor_emoji} {c.contributor_name}
                  </strong>
                  {c.is_anonymous && <span class='tag'>anónimo en público</span>}
                  <br />
                  <small>{c.contributor_email}</small>
                  {c.message && <div class='msg'>"{c.message}"</div>}
                </td>
                <td>{c.level_name ?? 'Aportación libre'}</td>
                <td>
                  {Number(c.amount).toFixed(2)} {currency}
                </td>
                <td>{methodLabel[c.payment_method] ?? c.payment_method}</td>
                <td>
                  <span class={`status status-${c.payment_status}`}>
                    {statusLabel[c.payment_status] ?? c.payment_status}
                  </span>
                  {c.completed_at && <br />}
                  {c.completed_at && <small>{fmtDate(c.completed_at)}</small>}
                </td>
                <td class='actions'>
                  {c.payment_status !== 'completed' && (
                    <form method='POST'>
                      <input type='hidden' name='_action' value='set_status' />
                      <input type='hidden' name='contribution_id' value={c.id} />
                      <input type='hidden' name='status' value='completed' />
                      <button type='submit' class='btn-primary btn-sm'>
                        ✔ Confirmar pago
                      </button>
                    </form>
                  )}
                  {c.payment_status === 'completed' && (
                    <form method='POST'>
                      <input type='hidden' name='_action' value='set_status' />
                      <input type='hidden' name='contribution_id' value={c.id} />
                      <input type='hidden' name='status' value='pending' />
                      <button
                        type='submit'
                        class='btn-secondary btn-sm'
                        onclick="return confirm('¿Volver a marcar como pendiente? Se restará del importe recaudado.')"
                      >
                        ↩ Marcar pendiente
                      </button>
                    </form>
                  )}
                  {c.payment_status === 'pending' && (
                    <form method='POST'>
                      <input type='hidden' name='_action' value='set_status' />
                      <input type='hidden' name='contribution_id' value={c.id} />
                      <input type='hidden' name='status' value='failed' />
                      <button
                        type='submit'
                        class='btn-delete btn-sm'
                        onclick="return confirm('¿Anular esta contribución?')"
                      >
                        ✕ Anular
                      </button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<style>
  .subnav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 24px;
  }
  .summary-item {
    background: var(--color-surface);
    border: 1px solid var(--color-admin-border);
    border-radius: var(--radius-lg);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .summary-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-admin-text);
  }
  .summary-label {
    font-size: 0.85rem;
    color: #64748b;
  }
  .table-wrap {
    overflow-x: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-admin-border);
    border-radius: var(--radius-lg);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .data-table th,
  .data-table td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-admin-border);
  }
  .data-table th {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748b;
    background: var(--color-admin-bg);
  }
  .data-table tr:last-child td {
    border-bottom: none;
  }
  .row-pending {
    background: #fffbeb;
  }
  .msg {
    margin-top: 4px;
    color: #475569;
    font-style: italic;
  }
  .tag {
    margin-left: 6px;
    font-size: 0.72rem;
    background: #e2e8f0;
    color: #334155;
    padding: 2px 6px;
    border-radius: 999px;
  }
  .status {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .status-pending {
    background: #fef3c7;
    color: #92400e;
  }
  .status-completed {
    background: #dcfce7;
    color: #166534;
  }
  .status-failed,
  .status-refunded {
    background: #fee2e2;
    color: #991b1b;
  }
  .status-processing {
    background: #dbeafe;
    color: #1e40af;
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 170px;
  }
  .btn-sm {
    padding: 6px 10px;
    font-size: 0.8rem;
    width: 100%;
  }
  .btn-primary,
  .btn-secondary,
  .btn-ghost,
  .btn-delete {
    display: inline-block;
    border-radius: var(--radius-sm);
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    font-family: inherit;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--color-admin-primary);
    color: #fff;
  }
  .btn-secondary {
    background: #fff;
    color: var(--color-admin-text);
    border-color: var(--color-admin-border);
  }
  .btn-ghost {
    background: transparent;
    color: var(--color-admin-primary);
    padding: 8px 12px;
    border-color: var(--color-admin-border);
  }
  .btn-delete {
    background: #fef2f2;
    color: #991b1b;
    border-color: #fecaca;
  }
  .alert-success,
  .alert-error {
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
    font-size: 0.9rem;
  }
  .alert-success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }
  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }
  .empty-state {
    color: #64748b;
    padding: 30px;
    text-align: center;
  }
</style>
