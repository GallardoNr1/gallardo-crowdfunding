---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContributionLevels from '@/components/ContributionLevels.astro';
import ContributorsListReact from '@/components/ContributorsListReact.astro';
import FamilyPhotos from '@/components/FamilyPhotos.astro';
import MessageSection from '@/components/MessageSection.astro';
import ProductCard from '@/components/ProductCard.astro';
import OpenCampaignSection from '@/components/OpenCampaignSection.astro';
import ProgressSection from '@/components/ProgressSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Footer from '@/layouts/Footer.astro';
import {
  campaignTimeline,
  campaignTotals,
  daysLeft,
  formatEndDate,
  isCampaignOpen,
} from '@/lib/campaign';
import { currencySymbol } from '@/lib/format';
import { getTheme } from '@/lib/themes';
import {
  getContributionLevels,
  getFamilyMembers,
  getImagesFromFolder,
  getPaymentMethods,
  getProjectByTenantAndSlug,
  getPublicContributions,
  getTenantByNumber,
  normalizeProjectPageContent,
} from '@/lib/supabase';
import { parseTenantParam, tenantUrl } from '@/lib/tenants';

export const prerender = false;

// URL: /<número de espacio>/projects/<slug>. El slug solo es único dentro del espacio.
const tenantNumber = parseTenantParam(Astro.params.tenant);
const tenant = tenantNumber ? await getTenantByNumber(tenantNumber) : null;
const { slug } = Astro.params;
const projectConfig =
  tenant && slug ? await getProjectByTenantAndSlug(tenant.id, slug) : null;

if (!tenant || !projectConfig) {
  return new Response(null, { status: 404 });
}
if (projectConfig.project_status === 'cancelled') {
  return Astro.redirect(tenantUrl(tenant.number));
}
const backHref = tenantUrl(tenant.number);
// Vista previa al compartir por WhatsApp: subtítulo o descripción (recortada) y la imagen del proyecto.
const shareDescription = (
  normalizeProjectPageContent(projectConfig.page_content).pageSubtitle ||
  projectConfig.project_description ||
  `Proyecto de ${tenant.name} en Gallardo Crowdfunding`
).slice(0, 200);

// Consultas independientes en paralelo (antes eran 7 viajes secuenciales a Supabase).
const [
  contributionLevels,
  contributions,
  familyMembers,
  photos,
  paymentMethods,
] = await Promise.all([
  getContributionLevels(projectConfig.id),
  getPublicContributions(projectConfig.id),
  getFamilyMembers(projectConfig.id),
  getImagesFromFolder(projectConfig.id),
  getPaymentMethods(),
]);

const completed = projectConfig.project_status === 'completed';
const mode = projectConfig.campaign_mode === 'open' ? 'open' : 'target';
const open = isCampaignOpen(projectConfig);
// Cerrada por fecha: sigue "activa" en BD pero ya no admite aportaciones.
const closedByDate = !open && projectConfig.project_status === 'active';
const finished = completed || closedByDate;
const totals = campaignTotals(projectConfig);
const remainingDays = daysLeft(projectConfig.end_date);
const endDateLabel = formatEndDate(projectConfig.end_date);
const startDateLabel = formatEndDate(projectConfig.start_date);
const timeline = campaignTimeline(
  projectConfig.start_date,
  projectConfig.end_date
);
const currency = currencySymbol(projectConfig.currency);
// Fuente de verdad del progreso: project_config.current_amount (lo mantiene el trigger / el servidor).
const currentAmount = Number(projectConfig.current_amount) || 0;
const targetAmount = Number(projectConfig.target_amount) || 0;
const content = normalizeProjectPageContent(projectConfig.page_content);
const theme = getTheme(content.theme);
const heroSlots: [string, string, string][] = [
  ['4%', '0s', '4.2s'],
  ['14%', '0.7s', '5s'],
  ['26%', '1.1s', '3.6s'],
  ['42%', '0.3s', '4.8s'],
  ['58%', '1.4s', '3.9s'],
  ['72%', '0.9s', '4.4s'],
  ['86%', '0.4s', '5.3s'],
];
const levelAmounts = contributionLevels
  .map((l) => Number(l.amount) || 0)
  .filter((a) => a > 0);
const minLevelAmount = levelAmounts.length
  ? Math.min(...levelAmounts)
  : undefined;
---

<BaseLayout
  title={content.pageTitle || projectConfig.project_name}
  subtitle={content.pageSubtitle}
  project={projectConfig}
  paymentMethods={paymentMethods}
  theme={theme}
  description={shareDescription}
  image={projectConfig.project_image_url || undefined}
>
  <div
    class='container'
    data-confetti={JSON.stringify(theme.emojis.confetti)}
  >
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: tenant.name, href: backHref },
        { label: projectConfig.project_name },
      ]}
    />
    <ProductCard
      title={projectConfig.project_name}
      description={projectConfig.project_description ?? ''}
      price={mode === 'open' ? undefined : targetAmount}
      href={
        mode === 'open' || !content.productUrl || content.productUrl === '#'
          ? undefined
          : content.productUrl
      }
      imageUrl={projectConfig.project_image_url ?? ''}
      imageAlt={projectConfig.project_name}
      completed={completed}
      icon={content.cta.icon}
      currency={currency}
      contributeHref={open ? '#contribuir' : undefined}
      contributeLabel={`${theme.emojis.spark} Quiero aportar`}
    />

    {mode === 'open' ? (
      <OpenCampaignSection
        title={content.progressTitle}
        raised={totals.raised}
        base={totals.base}
        baseLabel={projectConfig.base_label}
        total={totals.total}
        currency={currency}
        daysLeft={remainingDays}
        endDateLabel={endDateLabel}
        startDateLabel={startDateLabel}
        timeline={timeline}
        closed={!open}
      />
    ) : (
      <ProgressSection
        currentAmount={currentAmount}
        targetAmount={targetAmount}
        currency={currency}
        title={content.progressTitle}
        minLevelAmount={minLevelAmount}
      />
    )}

    {finished && (
      <section class='completed-hero'>
        <div
          class='completed-particles'
          aria-hidden='true'
        >
          {heroSlots.map(([left, delay, duration], i) => (
            <span
              style={`left:${left};animation-delay:${delay};animation-duration:${duration}`}
            >
              {theme.emojis.hero[i % theme.emojis.hero.length]}
            </span>
          ))}
        </div>
        <div class='completed-check'>{completed ? '🏆' : '🏁'}</div>
        <h2 class='completed-title'>
          {completed ? '¡Lo conseguimos!' : '¡Campaña cerrada!'}
        </h2>
        <div class='completed-amount-block'>
          <span class='completed-total'>
            {(mode === 'open' ? totals.total : currentAmount).toFixed(2)}{' '}
            {currency}
          </span>
          <span class='completed-label'>
            {mode === 'open'
              ? 'conseguidos entre todos'
              : `recaudados de ${targetAmount.toFixed(2)} ${currency}`}
          </span>
        </div>
        <p class='completed-msg'>
          Gracias a cada persona que sumó su granito de arena.
          <br />
          Juntos lo hicisteis posible. 💛
        </p>
      </section>
    )}

    {photos.length > 0 && (
      <FamilyPhotos
        title={content.photoSectionTitle}
        photos={photos}
        altPreText='Foto familiar'
      />
    )}

    {open && (
      <ContributionLevels
        levels={contributionLevels}
        currency={currency}
        allowCustomAmount={!!projectConfig.allow_custom_amount}
        minCustomAmount={Number(projectConfig.min_custom_amount) || 5}
        titleEmoji={theme.emojis.levels}
        spark={theme.emojis.spark}
        title={theme.texts.levelsTitle}
      />
    )}

    {!completed && (
      <ContributorsListReact
        contributors={contributions}
        contributorsTitle={content.contributorsTitle}
        projectId={projectConfig.id}
        currency={currency}
        contributorsStat={theme.texts.contributorsStat}
      />
    )}

    <MessageSection
      familyMembers={familyMembers}
      mainMessage={content.mainMessage}
      memberTitle={`${theme.emojis.family} ${theme.texts.familyTitle}`}
      callToAction={content.cta}
      project_id={projectConfig.id}
      sectionEmoji={theme.emojis.message}
      iconEmoji={theme.emojis.messageIcon}
      supportEmoji={theme.emojis.support}
      emptyEmoji={theme.emojis.empty}
      sectionTitle={theme.texts.messageTitle}
      supportTitle={theme.texts.supportTitle}
      supportEmpty={theme.texts.emptySupport}
    />

    <p class='back-link'>
      <a href={backHref}>← Volver a los proyectos de {tenant.name}</a>
    </p>
  </div>
  <Footer slot='footer' />
</BaseLayout>

<style>
  /* ── Completed hero ── */
  .completed-hero {
    background: linear-gradient(135deg, #fffde7, #fff3cd, #ffe57f);
    border-radius: var(--radius-2xl);
    padding: 52px 32px 44px;
    text-align: center;
    margin-bottom: 28px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(255, 204, 2, 0.28);
    border: 2px solid rgba(255, 204, 2, 0.35);
  }

  .completed-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .completed-particles span {
    position: absolute;
    top: -40px;
    font-size: 1.6rem;
    animation: floatParticle linear infinite;
  }

  @keyframes floatParticle {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.9;
    }
    80% {
      opacity: 0.4;
    }
    100% {
      transform: translateY(350px) rotate(360deg);
      opacity: 0;
    }
  }

  .completed-check {
    font-size: 4rem;
    margin-bottom: 10px;
    display: block;
    animation: popIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes popIn {
    from {
      transform: scale(0) rotate(-15deg);
      opacity: 0;
    }
    to {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  .completed-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    color: var(--color-section-orange-accent);
    margin: 0 0 20px;
    animation: fadeInUp 0.6s 0.3s ease both;
  }

  .completed-amount-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 22px;
    animation: fadeInUp 0.6s 0.5s ease both;
  }

  .completed-total {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 4.5rem);
    color: var(--color-brand-green-dark);
    line-height: 1;
    font-weight: 900;
  }

  .completed-label {
    font-size: 0.95rem;
    color: var(--color-section-orange-accent);
    opacity: 0.75;
  }

  .completed-msg {
    font-size: 1.05rem;
    color: #5d4037;
    max-width: 460px;
    margin: 0 auto;
    line-height: 1.65;
    animation: fadeInUp 0.6s 0.7s ease both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .global-error-banner {
    background: linear-gradient(145deg, #fff3cd, #ffeaa7);
    border: 2px solid #ffc107;
    border-radius: 15px;
    padding: 20px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(255, 193, 7, 0.2);
  }

  .error-content {
    display: flex;
    align-items: center;
    gap: 15px;
    text-align: center;
    justify-content: center;
  }

  .error-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .error-text {
    color: #856404;
    font-size: 1rem;
    line-height: 1.4;
  }

  .error-text strong {
    color: #533f03;
  }

  .status-active {
    color: var(--color-brand-green);
    font-weight: 600;
  }

  .status-completed {
    color: #2196f3;
    font-weight: 600;
  }

  .status-paused {
    color: var(--color-brand-orange);
    font-weight: 600;
  }

  .status-cancelled {
    color: #f44336;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .footer-content {
      padding: 30px 20px;
    }

    .footer-message h3 {
      font-size: 1.5rem;
    }

    .footer-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-separator {
      display: none;
    }

    .global-error-banner {
      margin: 10px;
      padding: 15px;
    }

    .error-content {
      flex-direction: column;
      gap: 10px;
    }
  }

  .back-link {
    text-align: center;
    margin: 36px 0 8px;
  }
  .back-link a {
    color: var(--color-brand-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .back-link a:hover {
    text-decoration: underline;
  }
</style>

<script>
  // contributionCompleted: una contribución confirmada por la familia (broadcast recibido por
  // ContributorsList) → confeti + aviso. contributionSubmitted: el visitante acaba de enviar
  // el formulario → solo confeti; el aviso llegará cuando se confirme.
  document.addEventListener('contributionCompleted', (event: Event) => {
    const { contributor } = (event as CustomEvent).detail ?? {};
    launchConfetti();
    showContributionNotification(contributor ?? {});

    const originalTitle = document.title;
    document.title = `🎉 ¡Nueva contribución! - ${originalTitle}`;
    setTimeout(() => {
      document.title = originalTitle;
    }, 5000);
  });

  document.addEventListener('contributionSubmitted', () => {
    launchConfetti();
  });

  function launchConfetti() {
    const celebration = document.createElement('div');
    celebration.style.cssText =
      'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999;';

    for (let i = 0; i < 100; i++) {
      setTimeout(() => createGlobalConfetti(celebration), i * 30);
    }

    document.body.appendChild(celebration);
    setTimeout(() => celebration.remove(), 8000);
  }

  // Confeti del tema del proyecto (lo inyecta el servidor en data-confetti).
  const CONFETTI: string[] = (() => {
    try {
      const raw = (
        document.querySelector('[data-confetti]') as HTMLElement | null
      )?.dataset.confetti;
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) && parsed.length
        ? parsed
        : ['🎉', '✨', '🌟'];
    } catch {
      return ['🎉', '✨', '🌟'];
    }
  })();

  function createGlobalConfetti(container: HTMLElement) {
    const confetti = document.createElement('div');
    const emojis = CONFETTI;
    confetti.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    confetti.style.cssText = `
      position: absolute;
      font-size: ${Math.random() * 25 + 15}px;
      left: ${Math.random() * 100}vw;
      top: -50px;
      animation: globalConfettiFall ${Math.random() * 4 + 3}s linear forwards;
      transform: rotate(${Math.random() * 360}deg);
      z-index: 10000;
    `;
    container.appendChild(confetti);
    setTimeout(() => confetti.remove(), 8000);
  }

  interface NotifiedContributor {
    name?: string;
    emoji?: string;
    level?: string;
    message?: string;
  }

  function showContributionNotification(contributor: NotifiedContributor) {
    const notification = document.createElement('div');
    notification.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      background: linear-gradient(145deg, #4caf50, #45a049);
      color: white;
      padding: 20px 25px;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(76, 175, 80, 0.4);
      z-index: 10001;
      animation: slideInRight 0.5s ease-out;
      max-width: 300px;
      font-family: 'Poppins', sans-serif;
    `;

    // Nombre, nivel y mensaje los escribe el contribuidor: siempre textContent, nunca innerHTML.
    const header = document.createElement('div');
    header.style.cssText =
      'display:flex;align-items:center;gap:12px;margin-bottom:8px;';
    const emoji = document.createElement('span');
    emoji.style.fontSize = '1.5rem';
    emoji.textContent = contributor.emoji ?? '🎉';
    const title = document.createElement('strong');
    title.style.fontSize = '1.1rem';
    title.textContent = '¡Nueva contribución!';
    header.append(emoji, title);

    const body = document.createElement('div');
    body.style.cssText = 'font-size:0.9rem;opacity:0.9;';
    const name = document.createElement('strong');
    name.textContent = contributor.name ?? 'Alguien';
    const level = document.createElement('strong');
    level.textContent = contributor.level ?? '';
    body.append(name, document.createTextNode(' se unió como '), level);
    if (contributor.message) {
      const quote = document.createElement('em');
      quote.textContent = `"${contributor.message}"`;
      body.append(document.createElement('br'), quote);
    }
    notification.append(header, body);

    document.body.appendChild(notification);

    setTimeout(() => {
      notification.style.animation = 'slideOutRight 0.5s ease-in';
      setTimeout(() => notification.remove(), 500);
    }, 6000);
  }

  const globalStyles = document.createElement('style');
  globalStyles.textContent = `
    @keyframes globalConfettiFall {
      to { transform: translateY(100vh) rotate(720deg); opacity: 0; }
    }
    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(100px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideOutRight {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(100px); }
    }
    .container { position: relative; z-index: 1; }
    html { scroll-behavior: smooth; }
  `;
  document.head.appendChild(globalStyles);

  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
    );

    // Las raíces de las islas React (hijas directas de <astro-island>) se excluyen: tocar su
    // className antes de hidratar provoca avisos de hydration mismatch y ya traen su animación.
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>(
        '.main-card, .progress-section, .completed-hero, .family-photos, .contributors-section, .message-section'
      )
    ).filter((el) => el.parentElement?.tagName !== 'ASTRO-ISLAND');

    targets.forEach((section, i) => {
      // Lo que ya está en pantalla al cargar no se anima: evita el "doble salto" visible.
      const rect = section.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) return;
      section.classList.add('reveal');
      section.style.transitionDelay = `${Math.min(i, 4) * 70}ms`;
      observer.observe(section);
    });

    // Red de seguridad: si el observer no llegara a disparar, nada queda oculto.
    setTimeout(() => targets.forEach((s) => s.classList.add('visible')), 2500);
  });
</script>
