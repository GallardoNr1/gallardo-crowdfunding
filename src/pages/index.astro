---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../layouts/Footer.astro';
import ProjectsList, {
  type ProjectListItem,
} from '@/components/ProjectsList.astro';
import { getPublicProjects } from '../lib/supabase';
import { projectUrl } from '@/lib/tenants';

// Escaparate: proyectos públicos de todos los espacios. (La landing completa llega en la fase 3.)
let items: ProjectListItem[] = [];
let errorLoadingProjects = false;

try {
  const projects = await getPublicProjects();
  items = projects.flatMap((project) =>
    project.tenants
      ? [
          {
            project,
            href: projectUrl(project.tenants.number, project.slug),
            by: project.tenants.name,
          },
        ]
      : []
  );
} catch (error) {
  console.error('Error loading projects:', error);
  errorLoadingProjects = true;
}
---

<BaseLayout title='Gallardo Crowdfunding'>
  <div class='container'>
    {errorLoadingProjects ? (
      <div class='global-error-banner'>
        <div class='error-content'>
          <span class='error-icon'>⚠️</span>
          <div class='error-text'>
            <strong>Problema cargando proyectos:</strong>
            Mostrando página sin datos en este momento.
          </div>
        </div>
      </div>
    ) : (
      <ProjectsList
        items={items}
        emptyText='No hay proyectos públicos todavía.'
      />
    )}
  </div>
  <Footer slot='footer' />

  <style>
    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
    }

    .global-error-banner {
      background: #fff3cd;
      border: 1px solid #ffeeba;
      border-radius: 10px;
      padding: 10px 15px;
      margin-bottom: 20px;
    }

    .error-content {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .error-icon {
      font-size: 1.5rem;
    }

    .error-text {
      color: #856404;
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
