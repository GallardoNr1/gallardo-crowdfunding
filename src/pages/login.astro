---
// Acceso con email y contraseña. Tras entrar, va a `next` (solo rutas internas) o a /admin.
export const prerender = false;

import AuthLayout from '@/layouts/AuthLayout.astro';
import { clientIp } from '@/lib/api';
import { safeNext } from '@/lib/auth-gate';
import { handleLogin } from '@/lib/auth-routes';
import { authLimiters, supabaseAuthApi } from '@/lib/auth-supabase';
import { setSessionCookies } from '@/lib/session-cookies';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) {
  return Astro.redirect(next);
}

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '');
  const result = await handleLogin(
    form,
    clientIp(Astro.request, Astro.clientAddress),
    {
      auth: supabaseAuthApi,
      limiter: authLimiters.login,
    }
  );
  if (result.ok) {
    setSessionCookies(Astro.cookies, result.session);
    return Astro.redirect(next);
  }
  error = result.error;
  Astro.response.status = result.status;
}

const justRegistered = Astro.url.searchParams.get('registro') === 'ok';
const passwordChanged = Astro.url.searchParams.get('contrasena') === 'ok';
const googleError = Astro.url.searchParams.get('error') === 'google';
const googleHref =
  next === '/admin'
    ? '/auth/google'
    : `/auth/google?next=${encodeURIComponent(next)}`;
---

<AuthLayout
  title='Entrar'
  heading='Entrar'
  subtitle='Accede a tu espacio y a tus proyectos'
>
  {justRegistered && (
    <div class='success-banner'>✅ Cuenta confirmada. Ya puedes entrar.</div>
  )}
  {passwordChanged && (
    <div class='success-banner'>
      ✅ Contraseña cambiada. Entra con la nueva.
    </div>
  )}
  {googleError && (
    <div class='error-banner'>
      ⚠️ No se pudo entrar con Google. Inténtalo de nuevo o usa tu email y
      contraseña.
    </div>
  )}
  {error && <div class='error-banner'>⚠️ {error}</div>}

  <form
    method='POST'
    class='auth-form'
  >
    <div class='field'>
      <label for='email'>Email</label>
      <input
        type='email'
        id='email'
        name='email'
        required
        autocomplete='email'
        value={email}
        placeholder='tu@email.com'
      />
    </div>

    <div class='field'>
      <label for='password'>Contraseña</label>
      <input
        type='password'
        id='password'
        name='password'
        required
        autocomplete='current-password'
        placeholder='••••••••'
      />
    </div>

    <button
      type='submit'
      class='submit-btn'
    >
      Entrar
    </button>
  </form>

  <div class='auth-divider'>
    <span>o</span>
  </div>
  <a
    class='google-btn'
    href={googleHref}
  >
    <svg
      class='google-icon'
      viewBox='0 0 24 24'
      aria-hidden='true'
    >
      <path
        fill='#EA4335'
        d='M12 10.2v3.9h5.5c-.2 1.3-1.5 3.9-5.5 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.4 14.6 2.4 12 2.4 6.7 2.4 2.4 6.7 2.4 12S6.7 21.6 12 21.6c5.5 0 9.2-3.9 9.2-9.4 0-.6-.1-1.1-.2-1.6H12z'
      />
    </svg>
    Entrar con Google
  </a>

  <p class='auth-links'>
    <a href='/recuperar'>¿Has olvidado la contraseña?</a>
    <br />
    ¿Aún no tienes cuenta? <a href='/registro'>Crea tu espacio</a>
  </p>
</AuthLayout>
