---
// Acceso con email y contraseña. Tras entrar, va a `next` (solo rutas internas) o a /admin.
export const prerender = false;

import AuthLayout from '@/layouts/AuthLayout.astro';
import { clientIp } from '@/lib/api';
import { safeNext } from '@/lib/auth-gate';
import { handleLogin } from '@/lib/auth-routes';
import { authLimiters, supabaseAuthApi } from '@/lib/auth-supabase';
import { setSessionCookies } from '@/lib/session-cookies';

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.user) {
  return Astro.redirect(next);
}

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '');
  const result = await handleLogin(
    form,
    clientIp(Astro.request, Astro.clientAddress),
    {
      auth: supabaseAuthApi,
      limiter: authLimiters.login,
    }
  );
  if (result.ok) {
    setSessionCookies(Astro.cookies, result.session);
    return Astro.redirect(next);
  }
  error = result.error;
  Astro.response.status = result.status;
}

const justRegistered = Astro.url.searchParams.get('registro') === 'ok';
const passwordChanged = Astro.url.searchParams.get('contrasena') === 'ok';
---

<AuthLayout
  title='Entrar'
  heading='Entrar'
  subtitle='Accede a tu espacio y a tus proyectos'
>
  {justRegistered && (
    <div class='success-banner'>✅ Cuenta confirmada. Ya puedes entrar.</div>
  )}
  {passwordChanged && (
    <div class='success-banner'>
      ✅ Contraseña cambiada. Entra con la nueva.
    </div>
  )}
  {error && <div class='error-banner'>⚠️ {error}</div>}

  <form
    method='POST'
    class='auth-form'
  >
    <div class='field'>
      <label for='email'>Email</label>
      <input
        type='email'
        id='email'
        name='email'
        required
        autocomplete='email'
        value={email}
        placeholder='tu@email.com'
      />
    </div>

    <div class='field'>
      <label for='password'>Contraseña</label>
      <input
        type='password'
        id='password'
        name='password'
        required
        autocomplete='current-password'
        placeholder='••••••••'
      />
    </div>

    <button
      type='submit'
      class='submit-btn'
    >
      Entrar
    </button>
  </form>

  <p class='auth-links'>
    <a href='/recuperar'>¿Has olvidado la contraseña?</a>
    <br />
    ¿Aún no tienes cuenta? <a href='/registro'>Crea tu espacio</a>
  </p>
</AuthLayout>
