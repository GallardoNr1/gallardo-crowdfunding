---
// Pie de página compacto: una sola fila (logo | lema | copyright y privacidad) que en móvil se apila.
export interface Props {
  year?: number;
}

const currentYear = new Date().getFullYear();
const { year = currentYear } = Astro.props;
---

<footer class='footer'>
  <div class='footer-container'>
    <a
      href='/'
      class='footer-logo-link'
      title='Ir a la página principal'
    >
      <svg
        class='footer-logo-svg'
        viewBox='0 0 238 64'
        fill='none'
        xmlns='http://www.w3.org/2000/svg'
        aria-label='Gallardo Crowdfunding'
        role='img'
      >
        <defs>
          <linearGradient
            id='gc-footer-grad'
            x1='0'
            y1='0'
            x2='64'
            y2='64'
            gradientUnits='userSpaceOnUse'
          >
            <stop stop-color='#ff6b35'></stop>
            <stop
              offset='1'
              stop-color='#c62828'
            ></stop>
          </linearGradient>
        </defs>
        <rect
          width='64'
          height='64'
          rx='15'
          fill='url(#gc-footer-grad)'
        ></rect>
        <rect
          x='29'
          y='0'
          width='6'
          height='64'
          fill='white'
          opacity='0.10'
          rx='3'
        ></rect>
        <rect
          x='0'
          y='29'
          width='64'
          height='6'
          fill='white'
          opacity='0.10'
          rx='3'
        ></rect>
        <ellipse
          cx='25'
          cy='12'
          rx='7'
          ry='3.5'
          fill='white'
          opacity='0.22'
          transform='rotate(-20 25 12)'
        ></ellipse>
        <ellipse
          cx='39'
          cy='12'
          rx='7'
          ry='3.5'
          fill='white'
          opacity='0.22'
          transform='rotate(20 39 12)'
        ></ellipse>
        <circle
          cx='32'
          cy='12'
          r='3'
          fill='white'
          opacity='0.30'
        ></circle>
        <text
          x='32'
          y='47'
          font-family="'Arial Black',sans-serif"
          font-size='26'
          font-weight='900'
          fill='white'
          text-anchor='middle'
          letter-spacing='-0.5'
        >
          GC
        </text>
        <line
          x1='80'
          y1='10'
          x2='80'
          y2='54'
          stroke='rgba(255,255,255,0.18)'
          stroke-width='1.5'
          stroke-linecap='round'
        ></line>
        <text
          x='90'
          y='30'
          font-family="'Helvetica Neue',Arial,sans-serif"
          font-size='17'
          font-weight='700'
          fill='#f0f4ff'
          letter-spacing='0.3'
        >
          Gallardo
        </text>
        <text
          x='90'
          y='49'
          font-family="'Helvetica Neue',Arial,sans-serif"
          font-size='10'
          font-weight='700'
          fill='#ff6b35'
          letter-spacing='2.5'
        >
          CROWDFUNDING
        </text>
      </svg>
    </a>

    <p class='brand-tagline'>Proyectos familiares llenos de corazón 💛</p>

    <p class='footer-copy'>
      © {year} · Creada con cariño ·{' '}
      <a
        href='/privacidad'
        class='footer-link'
      >
        Privacidad
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-header-bg);
    color: #e5e7eb;
    padding: 16px 20px;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    margin-top: 32px;
  }

  /* Una fila: logo | lema | copyright. */
  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-logo-link {
    display: inline-block;
    flex-shrink: 0;
    transition: var(--transition-normal);
  }

  .footer-logo-link:hover {
    opacity: 0.85;
  }

  .footer-logo-svg {
    width: 150px;
    height: auto;
    display: block;
  }

  .brand-tagline {
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.65;
    text-align: center;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.7;
    text-align: right;
    white-space: nowrap;
  }

  .footer-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .footer {
      padding: 18px 16px;
      text-align: center;
    }

    .footer-container {
      flex-direction: column;
      gap: 8px;
    }

    .footer-logo-svg {
      width: 130px;
    }

    .footer-copy {
      text-align: center;
      white-space: normal;
    }
  }
</style>
