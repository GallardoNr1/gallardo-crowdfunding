---
import { tenantInitials, tenantUrl } from '@/lib/tenants';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Gallardo Crowdfunding',
  subtitle = 'Elige un proyecto y únete a hacerlo realidad',
} = Astro.props;

// Sesión y espacio los deja el middleware en locals (null sin sesión).
const user = Astro.locals.user ?? null;
const tenant = Astro.locals.tenant ?? null;
const menuName = tenant?.name ?? user?.email ?? '';
---

<div class='header-bg'>
  <div class='header'>
    <div class='left'>
      <a
        class='home-link'
        href='/'
        title='Ir a la página principal'
      >
        <svg
          class='logo-svg'
          viewBox='0 0 64 64'
          fill='none'
          xmlns='http://www.w3.org/2000/svg'
        >
          <defs>
            <linearGradient
              id='gc-header-grad'
              x1='0'
              y1='0'
              x2='64'
              y2='64'
              gradientUnits='userSpaceOnUse'
            >
              <stop stop-color='#ff6b35' />
              <stop
                offset='1'
                stop-color='#c62828'
              />
            </linearGradient>
          </defs>
          <rect
            width='64'
            height='64'
            rx='15'
            fill='url(#gc-header-grad)'
          />
          <rect
            x='29'
            y='0'
            width='6'
            height='64'
            fill='white'
            opacity='0.10'
            rx='3'
          />
          <rect
            x='0'
            y='29'
            width='64'
            height='6'
            fill='white'
            opacity='0.10'
            rx='3'
          />
          <ellipse
            cx='25'
            cy='12'
            rx='7'
            ry='3.5'
            fill='white'
            opacity='0.22'
            transform='rotate(-20 25 12)'
          />
          <ellipse
            cx='39'
            cy='12'
            rx='7'
            ry='3.5'
            fill='white'
            opacity='0.22'
            transform='rotate(20 39 12)'
          />
          <circle
            cx='32'
            cy='12'
            r='3'
            fill='white'
            opacity='0.30'
          />
          <text
            x='32'
            y='47'
            font-family="'Arial Black',sans-serif"
            font-size='26'
            font-weight='900'
            fill='white'
            text-anchor='middle'
            letter-spacing='-0.5'
          >
            GC
          </text>
        </svg>
      </a>
    </div>

    <div class='center'>
      <h1 class='title'>{title}</h1>
      <p class='subtitle'>{subtitle}</p>
    </div>

    <div class='right'>
      {user ? (
        <details class='user-menu'>
          <summary aria-label={`Menú de ${menuName}`}>
            {tenant?.avatar_url ? (
              <img
                class='menu-avatar'
                src={tenant.avatar_url}
                alt=''
                width='40'
                height='40'
              />
            ) : (
              <span
                class='menu-avatar menu-avatar--initials'
                aria-hidden='true'
              >
                {tenantInitials(menuName)}
              </span>
            )}
            <span class='menu-name'>{menuName}</span>
            <span
              class='menu-caret'
              aria-hidden='true'
            >
              ▾
            </span>
          </summary>
          <div class='user-menu__panel'>
            {tenant && <a href={tenantUrl(tenant.number)}>🏠 Mi espacio</a>}
            <a href='/admin'>🛠️ Administrar</a>
            <a href='/cuenta'>👤 Mi cuenta</a>
            <form
              method='POST'
              action='/logout'
            >
              <button type='submit'>🚪 Salir</button>
            </form>
          </div>
        </details>
      ) : (
        <nav
          class='auth-links'
          aria-label='Acceso'
        >
          <a
            href='/login'
            class='auth-link'
          >
            Entrar
          </a>
          <a
            href='/registro'
            class='auth-link auth-link--primary'
          >
            Crear cuenta
          </a>
        </nav>
      )}
    </div>
  </div>
</div>

<style>
  .header-bg {
    background: var(--color-header-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-bottom: 4px solid transparent;
    border-image: linear-gradient(
        90deg,
        var(--color-brand-orange),
        var(--color-brand-yellow),
        var(--color-brand-primary)
      )
      1;
  }
  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 35px 20px;
    margin-bottom: 40px;
    gap: 20px;
    width: 100%;
    max-width: 1200px;
  }

  /* El logo va en absoluto: así el título se centra respecto a la página, no al hueco restante. */
  .left {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .center {
    flex: 1;
    text-align: center;
    /* Que el título no se meta debajo del logo ni del menú en anchos intermedios. */
    padding: 0 150px 0 88px;
  }

  /* Menú de usuario / accesos, en absoluto a la derecha (simétrico al logo). */
  .right {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
  }

  .auth-links {
    display: flex;
    gap: 8px;
  }

  .auth-link {
    color: var(--color-header-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    transition: var(--transition-fast);
  }

  .auth-link:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .auth-link--primary {
    background: var(--color-brand-orange);
    border-color: var(--color-brand-orange);
    color: #fff;
  }

  .auth-link--primary:hover {
    background: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
  }

  .user-menu {
    position: relative;
  }

  .user-menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    color: var(--color-header-text);
    padding: 4px 10px 4px 4px;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    transition: var(--transition-fast);
  }

  .user-menu summary::-webkit-details-marker {
    display: none;
  }

  .user-menu summary:hover,
  .user-menu[open] summary {
    background: rgba(255, 255, 255, 0.12);
  }

  .menu-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .menu-avatar--initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: linear-gradient(
      135deg,
      var(--color-brand-orange),
      var(--color-brand-primary)
    );
  }

  .menu-name {
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .menu-caret {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .user-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 200px;
    background: var(--color-surface, #fff);
    color: var(--color-text-primary, #222);
    border-radius: var(--radius-lg, 12px);
    box-shadow: var(--shadow-lg, 0 14px 30px rgba(0, 0, 0, 0.18));
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 50;
    animation: fadeInUp 0.18s ease both;
  }

  .user-menu__panel a,
  .user-menu__panel button {
    display: block;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .user-menu__panel a:hover,
  .user-menu__panel button:hover {
    background: var(--color-surface-muted, #f1f3f5);
  }

  .user-menu__panel form {
    border-top: 1px solid var(--color-surface-muted, #eee);
    margin-top: 4px;
    padding-top: 4px;
  }

  .logo-svg {
    width: 68px;
    height: 68px;
    display: block;
    transition: var(--transition-normal);
    filter: drop-shadow(0 4px 12px rgba(255, 107, 53, 0.35));
  }

  .home-link:hover .logo-svg {
    transform: scale(1.07) rotate(-3deg);
    filter: drop-shadow(0 6px 18px rgba(255, 107, 53, 0.55));
  }

  .title {
    font-family: var(--font-body);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-header-text);
    margin: 0;
    letter-spacing: -0.01em;
    animation: fadeInUp 0.6s ease both;
  }

  .subtitle {
    font-size: var(--text-md);
    color: var(--color-header-subtitle);
    margin-top: 6px;
    animation: fadeInUp 0.6s 0.15s ease both;
  }

  @media (max-width: 768px) {
    .header {
      flex-direction: column;
      padding: 25px 20px;
    }

    /* En móvil el logo y el menú vuelven al flujo, encima y debajo del título. */
    .left,
    .right {
      position: static;
      transform: none;
    }

    .right {
      margin-top: 14px;
    }

    .menu-name {
      max-width: 200px;
    }

    .user-menu__panel {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
    }

    .center {
      text-align: center;
      padding: 0;
    }

    .logo-svg {
      width: 56px;
      height: 56px;
    }
  }
</style>
